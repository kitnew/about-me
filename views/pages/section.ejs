<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <%- include('../partials/header') %>
    
    <main class="main-content">
        <section class="section-header">
            <div class="container">
                <h1 class="page-title"><%= data.title || section.charAt(0).toUpperCase() + section.slice(1) %></h1>
                <div class="breadcrumb">
                    <a href="/">Home</a> / <span><%= section.charAt(0).toUpperCase() + section.slice(1) %></span>
                </div>
            </div>
        </section>

        <section class="section-content">
            <div class="container">
                <% if (section === 'about') { %>
                    <div class="about-content">
                        <p class="about-description"><%= data.content || 'Content coming soon...' %></p>
                        <% if (data.interests && data.interests.length > 0) { %>
                            <h3>Interests</h3>
                            <ul class="interests-list">
                                <% data.interests.forEach(interest => { %>
                                    <li><%= interest %></li>
                                <% }); %>
                            </ul>
                        <% } %>
                    </div>
                <% } else if (section === 'skills') { %>
                    <div class="skills-content">
                        <% if (data.categories && data.categories.length > 0) { %>
                            <div class="skills-grid">
                                <% data.categories.forEach(category => { %>
                                    <div class="skill-category">
                                        <h3><%= category.name %></h3>
                                        <div class="skill-items">
                                            <% category.items.forEach(skill => { %>
                                                <span class="skill-tag"><%= skill %></span>
                                            <% }); %>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p>Skills content coming soon...</p>
                        <% } %>
                    </div>
                <% } else if (data.items && data.items.length > 0) { %>
                    <div class="items-grid">
                        <% data.items.forEach(item => { %>
                            <div class="item-card">
                                <% if (section === 'portfolio') { %>
                                    <h3><%= item.name %></h3>
                                    <p><%= item.description %></p>
                                    <% if (item.technologies) { %>
                                        <div class="technologies">
                                            <% item.technologies.forEach(tech => { %>
                                                <span class="tech-tag"><%= tech %></span>
                                            <% }); %>
                                        </div>
                                    <% } %>
                                    <div class="item-links">
                                        <% if (item.link) { %>
                                            <a href="<%= item.link %>" target="_blank" rel="noopener" class="btn btn-small">Code</a>
                                        <% } %>
                                        <% if (item.demo) { %>
                                            <a href="<%= item.demo %>" target="_blank" rel="noopener" class="btn btn-small">Demo</a>
                                        <% } %>
                                    </div>
                                <% } else { %>
                                    <h3><%= item.degree || item.position || item.activity || 'Item' %></h3>
                                    <h4><%= item.institution || item.company || item.organization || '' %></h4>
                                    <p class="item-period"><%= item.year || item.period || '' %></p>
                                    <p><%= item.description %></p>
                                <% } %>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="placeholder-content">
                        <h3>Content Coming Soon</h3>
                        <p>This section is being prepared with relevant information about <%= section %>.</p>
                        <p>Check back soon for updates!</p>
                    </div>
                <% } %>
            </div>
        </section>
    </main>
    
    <%- include('../partials/footer') %>
    
    <script src="/js/main.js"></script>
</body>
</html>